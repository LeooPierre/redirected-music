# Local sample-data mode. Ignored in production; never use real personal data in demo mode.
REDIRECTED_DEMO_MODE=true
APP_URL=http://127.0.0.1:3000
# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ADMIN_USER_ID=
# A real Cal.com event URL, e.g. https://cal.com/your-name/redirected
# Enable Requires Confirmation in Cal.com if bookings need your approval.
CAL_EVENT_URL=
